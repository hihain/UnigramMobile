<Page
    x:Class="Unigram.Views.VoIPPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unigram.Views"
    xmlns:controls="using:Unigram.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="320"
    d:DesignHeight="200"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    SizeChanged="OnSizeChanged">

    <Page.Resources>
        <SolidColorBrush x:Key="SignalBarForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SignalBarForegroundDisabledBrush" Color="#99FFFFFF"/>

        <Style TargetType="controls:GlyphToggleButton">
            <Setter Property="Background" Value="{ThemeResource ToggleButtonBackground}" />
            <Setter Property="Foreground" Value="{ThemeResource ToggleButtonForeground}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="{ThemeResource ToggleButtonBorderThemeThickness}" />
            <Setter Property="Padding" Value="8,4,8,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:GlyphToggleButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="24">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerDownThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundChecked}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundChecked}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundCheckedPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundCheckedPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundCheckedPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundCheckedPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerDownThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundCheckedDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundCheckedDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundIndeterminate}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundIndeterminate}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundIndeterminatePointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundIndeterminatePointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminatePressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundIndeterminatePressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBorderBrushIndeterminatePressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundIndeterminatePressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerDownThemeAnimation Storyboard.TargetName="RootGrid" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="IndeterminateDisabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonBackgroundIndeterminateDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleButtonForegroundIndeterminateDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBlock
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Text="{TemplateBinding CheckedGlyph}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RequestedTheme="Dark">
        <!--<Image x:Name="Image" Source="http://i.imgur.com/kx2hM3N.jpg" Opacity="0.6" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
        <Image x:Name="Image" Opacity="0.6" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Grid x:Name="RemoteVideo" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Border x:Name="LocalVideoPanel" Visibility="Collapsed" Width="112" Height="150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,60" Background="Transparent" BorderBrush="White" BorderThickness="2">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LocalVideoTransform"/>
            </Border.RenderTransform>
            <Grid>
                <Grid x:Name="LocalVideo" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Border x:Name="LocalVideoDragHandle" Background="#99000000" Height="24" VerticalAlignment="Top" PointerPressed="LocalVideoPanel_PointerPressed" PointerMoved="LocalVideoPanel_PointerMoved" PointerReleased="LocalVideoPanel_PointerReleased" PointerCanceled="LocalVideoPanel_PointerCanceled" PointerCaptureLost="LocalVideoPanel_PointerCaptureLost">
                    <TextBlock Text="Drag" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="BackgroundPanel" Background="Transparent" IsHitTestVisible="False"/>

        <Border
            x:Name="CallDetailsPanel"
            Background="#66000000"
            CornerRadius="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,32,0,0"
            Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border
                    x:Name="SmallEmojiLabel"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8"
                    Tapped="SmallEmojiLabel_Tapped"
                    AutomationProperties.Name="{CustomResource EncryptionKey}"
                    ToolTipService.ToolTip="{CustomResource EncryptionKey}">
                    <StackPanel x:Name="SmallPanel" Orientation="Horizontal" Height="24">
                        <Image x:Name="SmallEmoji0" Height="24" Width="24" Margin="0,0,4,0"/>
                        <Image x:Name="SmallEmoji1" Height="24" Width="24" Margin="0,0,4,0"/>
                        <Image x:Name="SmallEmoji2" Height="24" Width="24" Margin="0,0,4,0"/>
                        <Image x:Name="SmallEmoji3" Height="24" Width="24"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="FromLabel" Tapped="DebugString_Tapped" Grid.Row="1" MaxWidth="280" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource SubheaderTextBlockStyle}" Margin="0,0,0,4"/>
                <TextBlock x:Name="DurationLabel" Opacity="0" Text="00:00" TextAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Grid.Row="2"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="SignalBarsLabel" Visibility="Collapsed" Width="16" Height="12" HorizontalAlignment="Right" Margin="0,1,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="Signal1" Fill="{StaticResource SignalBarForegroundBrush}" RadiusX="1" RadiusY="1" Margin="0,0,1,0" Grid.Column="0" Grid.Row="3" Grid.RowSpan="1"/>
                        <Rectangle x:Name="Signal2" Fill="{StaticResource SignalBarForegroundBrush}" RadiusX="1" RadiusY="1" Margin="0,0,1,0" Grid.Column="1" Grid.Row="2" Grid.RowSpan="2"/>
                        <Rectangle x:Name="Signal3" Fill="{StaticResource SignalBarForegroundBrush}" RadiusX="1" RadiusY="1" Margin="0,0,1,0" Grid.Column="2" Grid.Row="1" Grid.RowSpan="3"/>
                        <Rectangle x:Name="Signal4" Fill="{StaticResource SignalBarForegroundBrush}" RadiusX="1" RadiusY="1" Margin="0,0,1,0" Grid.Column="3" Grid.Row="0" Grid.RowSpan="4"/>
                    </Grid>

                    <ContentControl x:Name="StateLabel" HorizontalContentAlignment="Center" Grid.Column="1">
                        <ContentControl.ContentTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition/>
                            </TransitionCollection>
                        </ContentControl.ContentTransitions>
                        <ContentControl.Clip>
                            <RectangleGeometry Rect="0,0,320,32"/>
                        </ContentControl.Clip>
                    </ContentControl>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="BlurPanel" Background="Transparent" IsHitTestVisible="False"/>

        <Grid x:Name="EmojifyPanel" Visibility="Collapsed" Background="#CC000000" Tapped="LargeEmojiLabel_Tapped">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                <Border x:Name="LargeEmojiLabel" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <StackPanel x:Name="LargePanel" Background="Transparent" Orientation="Horizontal">
                        <Image x:Name="LargeEmoji0" Source="ms-appx:///Assets/Emojis/0030-20e3.png" Height="48" Width="48" Margin="0,0,4,0"/>
                        <Image x:Name="LargeEmoji1" Source="ms-appx:///Assets/Emojis/0031-20e3.png" Height="48" Width="48" Margin="4,0"/>
                        <Image x:Name="LargeEmoji2" Source="ms-appx:///Assets/Emojis/0032-20e3.png" Height="48" Width="48" Margin="4,0"/>
                        <Image x:Name="LargeEmoji3" Source="ms-appx:///Assets/Emojis/0033-20e3.png" Height="48" Width="48" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="DescriptionLabel" Text="If these emoji are the same on {0}'s screen, this call is 100% secure." TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>
        </Grid>

        <Grid VerticalAlignment="Bottom" Margin="0,12">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                    <AddDeleteThemeTransition/>
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <controls:GlyphToggleButton
                x:Name="Mute"
                IsChecked="{x:Bind IsMuted, Mode=TwoWay}"
                IsOneWay="False"
                CheckedGlyph="&#xE610;"
                FontFamily="{StaticResource TelegramThemeFontFamily}"
                HorizontalAlignment="Right"
                Margin="0,0,12,0"
                AutomationProperties.Name="{CustomResource AccDescrMuteMic}"
                ToolTipService.ToolTip="{CustomResource AccDescrMuteMic}"/>
            <controls:GlyphButton
                x:Name="Camera"
                Visibility="Collapsed"
                Click="Camera_Click"
                Glyph="&#xE722;"
                Background="#99000000"
                Foreground="White"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="22"
                Radius="24"
                HorizontalAlignment="Right"
                Margin="0,0,68,0"
                AutomationProperties.Name="{CustomResource AccDescrSwitchCamera}"
                ToolTipService.ToolTip="{CustomResource AccDescrSwitchCamera}"
                Grid.Column="0"/>

            <Border x:Name="Close" Visibility="Collapsed" Background="#FFFFFF" CornerRadius="24" Grid.Column="1">
                <controls:GlyphButton
                    Click="Close_Click"
                    Glyph="&#xE10A;"
                    Foreground="#777777"
                    RequestedTheme="Light"
                    Radius="24"
                    AutomationProperties.Name="{CustomResource Close}"
                    ToolTipService.ToolTip="{CustomResource Close}"/>
            </Border>
            <Border x:Name="Accept" Visibility="Collapsed" Background="#64BA57" CornerRadius="24" Grid.Column="2">
                <controls:GlyphButton
                    Click="Accept_Click"
                    Glyph="&#xE13A;"
                    Radius="24"
                    AutomationProperties.Name="{CustomResource VoipAnswerCall}"
                    ToolTipService.ToolTip="{CustomResource VoipAnswerCall}"/>
            </Border>
            <Border x:Name="Discard" Background="#E33A32" CornerRadius="24" Grid.Column="3">
                <controls:GlyphButton
                    Click="Hangup_Click"
                    Glyph="&#xE60F;"
                    FontFamily="{StaticResource TelegramThemeFontFamily}"
                    FontSize="24"
                    Padding="0,0,0,2"
                    Radius="24"
                    AutomationProperties.Name="{CustomResource VoipEndCall}"
                    ToolTipService.ToolTip="{CustomResource VoipEndCall}"/>
            </Border>

            <!-- Not deferred: OnLoaded reads this element to wire AudioRoutingManager, and
                 a deferred element is still null at that point, which silently disabled
                 both the speakerphone toggle and all call audio routing. -->
            <controls:GlyphToggleButton x:Name="Routing" Visibility="Collapsed" Click="Routing_Click" CheckedGlyph="&#xE767;" HorizontalAlignment="Left" Margin="12,0,0,0" Grid.Column="4"/>
        </Grid>
    </Grid>
</Page>
