<local:HostedPage
    x:Class="Unigram.Views.Settings.Password.SettingsPasswordConfirmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Unigram.Views"
    xmlns:controls="using:Unigram.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <controls:WalkthroughControl
            HeaderSource="ms-appx:///Assets/Animations/TwoFactorSetupMail.tgs"
            Title="{CustomResource VerificationCode}"
            ButtonText="{CustomResource Continue}"
            ButtonCommand="{x:Bind ViewModel.SendCommand}">
            <controls:WalkthroughControl.Footer>
                <StackPanel Margin="0,8,0,0">
                    <HyperlinkButton
                        Command="{x:Bind ViewModel.ResendCommand}"
                        Content="{CustomResource ResendCode}"
                        HorizontalAlignment="Center"/>
                    <HyperlinkButton
                        Command="{x:Bind ViewModel.AbortCommand}"
                        Content="{CustomResource AbortPasswordMenu}"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </controls:WalkthroughControl.Footer>
            <StackPanel MaxWidth="320">
                <TextBlock
                    Text="{CustomResource EmailPasswordConfirmText2}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Center"/>
                <TextBlock
                    Text="{x:Bind ViewModel.Pattern, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Pattern, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    Margin="0,4,0,0"/>
                <TextBox
                    x:Name="Field1"
                    Margin="0,12,0,0"
                    Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{CustomResource Code}"
                    InputScope="Number"/>
            </StackPanel>
        </controls:WalkthroughControl>
    </Grid>
</local:HostedPage>