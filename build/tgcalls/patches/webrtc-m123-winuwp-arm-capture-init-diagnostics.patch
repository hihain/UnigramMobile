+}
+
 HRESULT WaitForASyncWithEvent(
     _In_ IAsyncInfo* async_info,
     _In_ std::shared_ptr<HANDLE> event_completed_handle_ptr,
@@ -1174,6 +1183,9 @@ struct CaptureDeviceInternal
       return 0;
     }
 
+    InterlockedExchange(&g_unigram_webrtc_capture_init_stage, 1);
+    InterlockedExchange(&g_unigram_webrtc_capture_init_hresult, E_FAIL);
+
     if (QueryPerformanceFrequency(&_perfCounterFreq) == 0) {
       return -1;
     }
@@ -1207,6 +1219,7 @@ struct CaptureDeviceInternal
 
     // Retrieve the stream format that the audio engine uses for its internal
     // processing (mixing) of shared-mode streams.
+    InterlockedExchange(&g_unigram_webrtc_capture_init_stage, 6);
     hr = _audioClient->GetMixFormat(&pWfxIn);
     if (SUCCEEDED(hr)) {
       RTC_LOG(LS_VERBOSE) << "Audio Engine's current capturing mix format:";
@@ -1239,6 +1252,7 @@ struct CaptureDeviceInternal
     hr = S_FALSE;
 
