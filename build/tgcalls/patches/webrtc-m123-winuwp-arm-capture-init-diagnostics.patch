+    InterlockedExchange(&g_unigram_webrtc_capture_init_stage, 7);
     for (unsigned int freq = 0; freq < sizeof(freqs) / sizeof(freqs[0]);
          freq++) {
       for (unsigned int chan = 0;
@@ -1304,6 +1318,7 @@ struct CaptureDeviceInternal
     }
 
