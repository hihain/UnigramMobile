+// Privacy-safe receive-path counters for the experimental Windows 10 Mobile bridge.
+// Audio can be silent for three very different reasons that look identical from the
+// playout buffer: no media arrives at all, media arrives but cannot be parsed, or it
+// parses but no receive stream claims it. Counting each separately is what tells a
+// transport fault apart from an SSRC or payload mismatch. Only packet counts are kept;
+// nothing derived from packet contents is recorded.
+std::atomic<uint32_t> g_diagIncomingAudioRtp{0};
+std::atomic<uint32_t> g_diagIncomingAudioRtcp{0};
+std::atomic<uint32_t> g_diagIncomingAudioParseFailed{0};
+std::atomic<uint32_t> g_diagIncomingAudioUndemuxed{0};
+
+// When a peer delivers RTCP but no RTP at all, the remaining question is whether the
+// peer believes it is transmitting. A sender report is only emitted by a peer that has
+// an active send stream, and transport feedback is only emitted by a peer that is
+// receiving our media, so the two together place the fault on one side of the link.
+std::atomic<uint32_t> g_diagIncomingAudioRtcpSenderReport{0};
+std::atomic<uint32_t> g_diagIncomingAudioRtcpFeedback{0};
+std::atomic<uint32_t> g_diagIncomingAudioMaxBytes{0};
+std::atomic<uint32_t> g_diagOutgoingAudioRtp{0};
+std::atomic<uint32_t> g_diagOutgoingAudioRtcp{0};
+std::atomic<int> g_diagAecEnabled{-1};
+std::atomic<int> g_diagAecMobileMode{-1};
+std::atomic<int> g_diagNoiseSuppressionEnabled{-1};
+std::atomic<int> g_diagGainControlEnabled{-1};
+std::atomic<int> g_diagAecResidualLikelihoodPermille{-1};
+std::atomic<int> g_diagAecResidualLikelihoodRecentMaxPermille{-1};
+std::atomic<int> g_diagAecEchoReturnLossDecibelTenths{-10000};
+std::atomic<int> g_diagAecEchoReturnLossEnhancementDecibelTenths{-10000};
+std::atomic<int> g_diagAecDelayMilliseconds{-1};
+
+static int diagQuantizeProbability(const absl::optional<double>& value) {
+    if (!value.has_value() || !std::isfinite(*value)) {
+        return -1;
+    }
+    if (*value <= 0.0) {
+        return 0;
+    }
+    if (*value >= 1.0) {
+        return 1000;
+    }
+    return static_cast<int>(std::lround(*value * 1000.0));
+}
+
+static int diagQuantizeDecibels(const absl::optional<double>& value) {
+    if (!value.has_value() || !std::isfinite(*value)) {
+        return -10000;
+    }
+    if (*value <= -999.9) {
+        return -9999;
+    }
+    if (*value >= 999.9) {
+        return 9999;
+    }
+    return static_cast<int>(std::lround(*value * 10.0));
+}
+
+void RecordAudioProcessingDiagnostics(webrtc::AudioProcessing* audioProcessing) {
+    if (audioProcessing == nullptr) {
+        return;
+    }
+
+    const auto config = audioProcessing->GetConfig();
+    g_diagAecEnabled.store(config.echo_canceller.enabled ? 1 : 0, std::memory_order_relaxed);
+    g_diagAecMobileMode.store(config.echo_canceller.mobile_mode ? 1 : 0, std::memory_order_relaxed);
+    g_diagNoiseSuppressionEnabled.store(config.noise_suppression.enabled ? 1 : 0, std::memory_order_relaxed);
+    g_diagGainControlEnabled.store(
+        config.gain_controller1.enabled || config.gain_controller2.enabled ? 1 : 0,
+        std::memory_order_relaxed);
+
+    const auto statistics = audioProcessing->GetStatistics();
+    g_diagAecResidualLikelihoodPermille.store(
+        diagQuantizeProbability(statistics.residual_echo_likelihood),
+        std::memory_order_relaxed);
+    g_diagAecResidualLikelihoodRecentMaxPermille.store(
+        diagQuantizeProbability(statistics.residual_echo_likelihood_recent_max),
+        std::memory_order_relaxed);
+    g_diagAecEchoReturnLossDecibelTenths.store(
+        diagQuantizeDecibels(statistics.echo_return_loss),
+        std::memory_order_relaxed);
+    g_diagAecEchoReturnLossEnhancementDecibelTenths.store(
+        diagQuantizeDecibels(statistics.echo_return_loss_enhancement),
+        std::memory_order_relaxed);
+    g_diagAecDelayMilliseconds.store(
+        statistics.delay_ms.value_or(-1),
+        std::memory_order_relaxed);
+}
+
+// Compound RTCP interleaves several report blocks in one packet, so the presence of a
+// sender report cannot be read from the leading payload type alone. Only the kind of
+// each report block is recorded; no identifier, timestamp or payload is inspected.
+static void diagScanIncomingAudioRtcp(const rtc::CopyOnWriteBuffer &packet) {
+    const uint8_t *const bytes = packet.cdata();
+    size_t offset = 0;
+    while (offset + 4 <= packet.size()) {
+        const uint8_t payloadType = bytes[offset + 1];
+        const size_t blockSize =
+            (static_cast<size_t>((bytes[offset + 2] << 8) | bytes[offset + 3]) + 1) * 4;
+        if (offset + blockSize > packet.size()) {
+            break;
+        }
+        if (payloadType == 200) {
+            g_diagIncomingAudioRtcpSenderReport.fetch_add(1, std::memory_order_relaxed);
+        } else if (payloadType == 205 || payloadType == 206) {
+            g_diagIncomingAudioRtcpFeedback.fetch_add(1, std::memory_order_relaxed);
+        }
+        offset += blockSize;
+    }
+}
+
+// A transport that silently drops anything above a size threshold would look exactly
+// like a peer that never sends audio, so the largest message accepted is recorded too.
+static void diagRecordIncomingAudioSize(size_t size) {
+    const uint32_t observed = static_cast<uint32_t>(size);
+    uint32_t previous = g_diagIncomingAudioMaxBytes.load(std::memory_order_relaxed);
+    while (observed > previous &&
+           !g_diagIncomingAudioMaxBytes.compare_exchange_weak(previous, observed, std::memory_order_relaxed)) {
+    }
+}
+
+void RecordIncomingAudioRtpDiagnostics(const rtc::CopyOnWriteBuffer &packet) {
+    diagRecordIncomingAudioSize(packet.size());
+    g_diagIncomingAudioRtp.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordIncomingAudioRtcpDiagnostics(const rtc::CopyOnWriteBuffer &packet) {
+    diagRecordIncomingAudioSize(packet.size());
+    g_diagIncomingAudioRtcp.fetch_add(1, std::memory_order_relaxed);
+    diagScanIncomingAudioRtcp(packet);
+}
