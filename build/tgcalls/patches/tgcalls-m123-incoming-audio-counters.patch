 void NativeNetworkingImpl::RtpPacketReceived_n(rtc::CopyOnWriteBuffer *packet, int64_t packet_time_us, bool isUnresolved) {
+    // V2 receives already-decrypted RTP here, after the selected SRTP transport has
+    // classified the datagram. Keep the experimental aggregate media counter aligned
+    // with the V1 receive path without retaining packet contents or identifiers.
+    RecordIncomingAudioRtpDiagnostics(*packet);
     if (_transportMessageReceived) {
         _transportMessageReceived(*packet, isUnresolved);
     }
 }
 
 void NativeNetworkingImpl::OnRtcpPacketReceived_n(rtc::CopyOnWriteBuffer *packet, int64_t packet_time_us) {
+    // RTCP is delivered separately by the SRTP transport, so aggregate sender-report
+    // and feedback totals remain meaningful for V2 calls as well as V1 calls.
+    RecordIncomingAudioRtcpDiagnostics(*packet);
     if (_rtcpPacketReceived) {
         _rtcpPacketReceived(*packet, packet_time_us);
     }
